.{
    .kernel = "images/vmlinux",
    .disk = "images/docker-zig.ext4",
    .cmdline =
    \\console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw init=/init loglevel=1
    \\dst.mode=run
    ,
    .cmdline_reboot =
    \\console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw init=/init loglevel=1
    \\dst.mode=check
    ,
    .memory_mib = 1536,
    .preemption = true,
    .runner = true,
    .seed = 1,
    .seeds = 1,
    .transcript_output = "images/docker-zig.transcript",
}
