diff -ru a/arch/x86/kernel/traps.c b/arch/x86/kernel/traps.c
--- a/arch/x86/kernel/traps.c	2026-10-12 06:53:47.244208000 +0000
+++ b/arch/x86/kernel/traps.c	2026-10-12 06:53:47.253208000 +0000
@@ -615,6 +615,54 @@
 
 #define GPFSTR "general protection fault"
 
+static DEFINE_PER_CPU(u64, tsc_emulated);
+
+static bool fixup_tsc_exception(struct pt_regs *regs)
+{
+	unsigned char insn[3];
+	unsigned long ip;
+	unsigned int length;
+	u64 tsc;
+
+	if (!(__read_cr4() & X86_CR4_TSD) || test_thread_flag(TIF_NOTSC))
+		return false;
+
+	if (insn_get_effective_ip(regs, &ip))
+		return false;
+
+	if (copy_from_user(insn, (const void __user *)ip, 2) || insn[0] != 0x0f)
+		return false;
+
+	if (insn[1] == 0x31) {
+		length = 2;
+	} else if (insn[1] == 0x01) {
+		if (get_user(insn[2], (const unsigned char __user *)(ip + 2)))
+			return false;
+
+		if (insn[2] != 0xf9)
+			return false;
+
+		length = 3;
+	} else {
+		return false;
+	}
+
+	preempt_disable();
+	tsc = max(ktime_get_ns(), this_cpu_read(tsc_emulated) + 1);
+	this_cpu_write(tsc_emulated, tsc);
+	preempt_enable();
+
+	regs->ax = lower_32_bits(tsc);
+	regs->dx = upper_32_bits(tsc);
+
+	if (length == 3)
+		regs->cx = raw_smp_processor_id();
+
+	regs->ip += length;
+
+	return true;
+}
+
 static bool fixup_iopl_exception(struct pt_regs *regs)
 {
 	struct thread_struct *t = &current->thread;
@@ -753,6 +801,9 @@
 		if (fixup_iopl_exception(regs))
 			goto exit;
 
