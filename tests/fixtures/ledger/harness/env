export PATH="/opt/venv/bin:$PATH"
export DJANGO_SETTINGS_MODULE=ledger.settings
export PYTHONPATH="$PYTHONPATH:/opt/project/src"

if [ "$CELESTE_APP" = replica ]; then
    export CELESTE_HOST_REDIS=primary
    export CELESTE_NODE_REDIS=primary
    export CELESTE_NODES=primary

    if [ "$CELESTE_REPLICAS" != 0 ]; then
        export CELESTE_NODES="primary replica"
    fi
elif [ "$CELESTE_TOPOLOGY" = nodes ]; then
    export CELESTE_HOST_POSTGRES=db
    export CELESTE_HOST_REDIS=cache
    export CELESTE_NODE_POSTGRES=db
    export CELESTE_NODE_REDIS=cache
    export CELESTE_NODES="db cache"
fi
